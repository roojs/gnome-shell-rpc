prefix=@prefix@
libdir=@libdir@
typelibdir=@typelibdir@
girdir=@girdir@
mutter_includedir=@mutter_includedir@

Name: mutter-rpc
Description: Mutter-shaped RPC client (GJS + C Meta-16)
Version: @version@
Requires: gio-2.0, gobject-2.0, atk, pango, mutter-cogl-16, mutter-mtk-16
Libs: -L${libdir} -lmutter-rpc-16
Cflags: -I${mutter_includedir}
