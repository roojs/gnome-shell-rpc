# gi-stub-gen overrides for St-16 (Type.method key=value).

# Emit GIR implements, including foreign (Clutter.Animatable on Widget).
# Deny an iface name (qualified if foreign) to skip it.
Namespace emit_implements=1

# Stock St.Adjustment implements Clutter.Animatable (find_property / ease).
Adjustment implements=Clutter.Animatable

# Stock St.ImageContent implements Clutter.Content (Actor.content).
ImageContent implements=Clutter.Content

# Class vfunc slots (Button.clicked/transition, Widget.get_focus_chain, …).
# Signal class closures are signal_* virtual signals (this class's GIR signal).
Namespace emit_class_slots=1

Widget.get_focus_chain list_elem=Widget

# TEMPORARY split: preserve GJS vfunc_style_changed and the stock signal.
Widget.style_changed split_signal_vfunc=1

# TEMPORARY — explicit inline CSS is commonly changed after construction.
# Forwarding the server's synchronous style-changed emission re-enters libgjs
# from call_poll() and crashes. Remove these when RPC notifications are
# dispatched outside the active GJS→RPC frame.
Widget.set_style local_emit_after=emit_style_changed_after_rpc

# Client-local — St.ScrollViewFade is a shell-side effect (no mutter
# St-ScrollViewFade helper). GJS reads vfade.fade_margins.top.
ScrollViewFade.fade_margins local=1
