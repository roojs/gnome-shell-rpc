# Meta generate/compile deny list (Type.method or bare name).
# Trailing "noop": empty stub / return true / return 0.
#
# Every entry needs a reason and permanence:
#   TEMPORARY — corridor/mock stand-in; undeny + wire when that work lands
#   PERMANENT — hand override owns the body, GIR/Vala/ABI clash, or
#               non-marshallable; not deferred RPC
# Prefer TEMPORARY unless the symbol will not later become a generated stub.
#
# ************************************************************************
# TEMPORARY — revisit / undeny when implementing (keep this block together)
# ************************************************************************

# Mutter WindowActor constructor is what *sets*; JS only *gets*
# (get_compositor_private is wired). Revisit if a client must attach an actor.
Window.set_compositor_private noop

# Priority E (0.5.5) — temporary until wired, or omit when hand override owns.
# Constructors with hand overrides: deny (override body). Bare temporary →
# emit GLib.error("… temporary — implement this").
BackgroundImageCache.purge noop
Background.set_blend noop
ShapedTexture.set_mask_texture noop
MultiTexture.new temporary
MultiTexture.new_simple temporary
# Hand: WaylandClient.override.vala + Helper-WaylandClient
WaylandClient.new
WaylandClient.spawnv

# ************************************************************************
# PERMANENT — not deferred RPC work
# ************************************************************************

# --- Hand class / construct (override or dedicated Vala) ---

# Client owns attach: BackgroundActor.override sets actor.content.
# Full class: src/gi-stub/BackgroundContent.vala (implements Clutter.Content).
# Meta.overrides: register=hand → Bin.register inline in Meta.register().
BackgroundContent
Background.new
Background.meta_display
BackgroundActor.new
BackgroundActor.meta_display
BackgroundActor.monitor

# Bodies from src/gi-stub/overrides/{Type}.override.vala (+ Helpers).
SoundPlayer.play_from_file
SoundPlayer.play_from_theme
Background.set_file
# GLib.File not on wire — URI string in BackgroundImageCache.override.vala.
BackgroundImageCache.load
Context.terminate_with_error
Context.terminate
Context.run_main_loop
IdleMonitor.add_idle_watch
IdleMonitor.add_user_active_watch
# GSourceFunc not RPC-marshallable (Laters.override.vala).
Laters.add
Laters.remove
# Hand: emit Display::workareas-changed after RPC (OPC notify missed).
# Skip RPC+emit when struts unchanged (layout.js _updateRegions loop).
Workspace.set_builtin_struts
Workspace.get_display
Workspace.get_work_area_for_monitor
# layout.js reads these every _updateRegions.
WorkspaceManager.n_workspaces
WorkspaceManager.get_n_workspaces
WorkspaceManager.get_workspace_by_index
Display.add_keybinding
Display.get_startup_notification
keybindings_set_custom_handler
Window.foreach_transient
Window.foreach_ancestor
Window.begin_grab_op
Display.request_pad_osd
Display.get_pad_button_label
Display.get_pad_feature_label
Display.is_pointer_emulating_sequence
WindowActor.paint_to_content
Selection.transfer_async
Selection.transfer_finish
SelectionSource.read_async
SelectionSource.read_finish
SelectionSourceMemory.new
ShapedTexture.get_image
WindowActor.get_image
WaylandCompositor.get_wayland_display

# C ABI / opaque settings — MetaSettingsAbi + Backend.override.
Backend.get_settings
Settings.get_ui_scaling_factor

# --- Compositor C bootstrap only (JS never calls; not a GJS wire gap) ---

Context.configure noop
Context.add_option_entries noop
Context.add_option_group noop
Context.set_plugin_gtype noop
Plugin.manager_set_plugin_type noop

# X11 GHashTable helpers for XIDs; gnome-shell JS never calls them.
unsigned_long_equal noop
unsigned_long_hash noop
