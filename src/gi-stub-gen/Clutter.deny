# Clutter generate/compile deny list.
#
# Every entry needs a reason and permanence:
#   TEMPORARY — corridor/mock stand-in; undeny + wire when that work lands
#   PERMANENT — hand override owns the body, GIR/Vala/ABI clash, or
#               non-marshallable; not deferred RPC
# Prefer TEMPORARY unless the symbol will not later become a generated stub.
#
# ************************************************************************
# TEMPORARY — revisit / undeny when implementing (keep this block together)
# ************************************************************************

# Generator: GString returns (GLib.String maps poorly).
FrameClock.get_max_render_time_debug_info

# Array wire mapping missing (noop keeps C symbol).
PaintNode.add_rectangles noop
PaintNode.add_texture_rectangles noop
ActorBox.from_vertices noop
Actor.get_abs_allocation_vertices noop

# Mock a11y: GenericAccessible has no rpc_lid. Undeny when Atk peers leased.
Actor.accessible
Actor.get_accessible
Actor.set_accessible

# ************************************************************************
# PERMANENT — not deferred RPC work
# ************************************************************************

# --- Hand override owns GIR prop/method (generator must not emit) ---

# BindConstraint.override — hand construct props; sync set_* after mint.
# Lease via Clutter-BindConstraint.new (Helper.Constraint Ffi mint).
BindConstraint.new
BindConstraint.source
BindConstraint.coordinate
BindConstraint.offset
BindConstraint.get_source
BindConstraint.set_source
BindConstraint.get_coordinate
BindConstraint.set_coordinate
BindConstraint.get_offset
BindConstraint.set_offset

# ClickAction.override — client-local pressed/enabled (ActorMeta size-locked).
ClickAction.pressed

# SnapConstraint.override — from/to_edge only (GIR uses get/set_edges OUTs;
# generator skips those props). source/offset stay generated.
# Lease via Clutter-SnapConstraint.new (Helper.Constraint Ffi mint).
SnapConstraint.new
SnapConstraint.from_edge
SnapConstraint.to_edge
SnapConstraint.get_edges
SnapConstraint.set_edges

# AlignConstraint.override — leaf mint + pivot_point Graphene.Point relay.
AlignConstraint.new
AlignConstraint.pivot_point
AlignConstraint.get_pivot_point
AlignConstraint.set_pivot_point

# ActorBox.override — local field math (struct, no rpc_lid).
ActorBox.init_rect
ActorBox.init
ActorBox.set_origin
ActorBox.set_size
ActorBox.get_origin
ActorBox.get_size
ActorBox.get_x
ActorBox.get_y
ActorBox.get_width
ActorBox.get_height
ActorBox.get_area
ActorBox.contains
ActorBox.equal
ActorBox.is_initialized
ActorBox.scale
ActorBox.interpolate
ActorBox.union

# Actor.override — lease walk (St-Widget → Helper-Actor.create); layout relay.
Actor.new
Actor.get_preferred_width
Actor.get_preferred_height
Actor.allocate

# Actor.override — content RPC when Content.rpc_lid set; else local identity.
Actor.content
Actor.get_content
Actor.set_content

# Actor.override — pivot_point Graphene.Point (methods denied: C symbol clash
# with GObject property accessors).
Actor.pivot_point
Actor.get_pivot_point
Actor.set_pivot_point

# Actor.override — scale axes via get_scale/set_scale (no GIR get_scale_x).
Actor.scale_x
Actor.scale_y

# Actor.override — visible via is_visible/show/hide; constraints/actions timing.
Actor.visible
Actor.constraints
Actor.get_constraints
Actor.effect
Actor.actions

# Actor.override — GJS LayoutManager subclasses have no rpc_lid.
Actor.layout_manager
Actor.get_layout_manager
Actor.set_layout_manager

# Backend.override — GJS InputMethod has no rpc_lid (client-owned).
Backend.input_method
Backend.get_input_method
Backend.set_input_method

# Stock C symbol in header-overrides/clutter-main.h — Clutter.override.vala.
get_default_text_direction

# Header-sized GTypes (Vala priv* vs stock 24B OffscreenEffect).
ActorMeta
Effect
OffscreenEffect
ActorMetaPrivate

# Opaque GIR privates — clash with Vala GObject instance private + rpc_lid.
ActorPrivate
PaintNodePrivate
ActorAccessiblePrivate

# GIR ctor shape vs Vala Object() for node subclasses.
PipelineNode.new

# GIR ctor returns Effect*; lease-on-construct is hand in
# BrightnessContrastEffect.override (setters must not RPC during wire decode).
BrightnessContrastEffect.new

# DesaturateEffect.override — GIR new(factor); GJS uses empty / { name }.
DesaturateEffect.new
DesaturateEffect.factor
DesaturateEffect.get_factor
DesaturateEffect.set_factor

# GLib.Closure is not a memcpy blob.
BindingPool.install_closure
BindingPool.override_closure

# Opaque event sequence handle — Clutter.override.vala.
EventSequence

# GSourceFunc not DBus-marshallable; Helper / Live.Callback instead.
threads_add_repaint_func

# Nested Event <function>s duplicate ns clutter_event_* cnames.
Event.add_filter
Event.get
Event.remove_filter

# Boxed ref/unref clash with GObject.
PaintContext.ref
PaintContext.unref
PickContext.ref
PickContext.unref

# Signal vs method name clash — destroy_rpc in Actor.override.
Actor.destroy

# Vala auto-emits free/dup when struct has methods.
ActorBox.free
ActorBox.copy

# Struct methods hand-implemented (ActorIter.override) via sibling RPC.
ActorIter.destroy
ActorIter.init
ActorIter.is_valid
ActorIter.next
ActorIter.prev
ActorIter.remove
