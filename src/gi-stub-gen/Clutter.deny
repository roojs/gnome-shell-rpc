Actor.scale_x
Actor.scale_y
Actor.get_scale
Actor.set_scale

# Actor.override — translation via get/set_translation (set_property GValue wire).
Actor.translation_x
Actor.translation_y
Actor.translation_z

# Actor.override — still relay show/hide (Clutter-Actor.show/hide RPC).
# Deny generated bodies so the hand methods can set the local visible
# flag in the same call. GIR property is :visible; is_visible() stays
# generated (mapped chain). Class slots rename to show_vfunc/hide_vfunc.
Actor.visible
Actor.show
Actor.hide
signal:Actor.show
signal:Actor.hide
Actor.name
Actor.get_name
Actor.set_name
Actor.constraints
Actor.get_constraints
Actor.effect
Actor.actions

# Actor.override — GJS LayoutManager subclasses have no rpc_lid.
Actor.layout_manager
Actor.get_layout_manager
Actor.set_layout_manager

# Actor.override — get_transition still RPCs; arms Live.Subscribe for
# Transition::stopped so environment.js ease() onComplete can run.
Actor.get_transition

# Stage.override — Event is Compact / not wireable; pick at event coords
# (captured-event-smoke / PopupMenuManager close).
Stage.get_event_actor

# Transition.override — capital-V on stock set_*_value (Gi pin).
