# Clutter generate/compile deny list.

# layout.js JSObject construct props — BindConstraint.override.vala.
BindConstraint.source
BindConstraint.coordinate
BindConstraint.offset
BindConstraint.get_source
BindConstraint.set_source
BindConstraint.get_coordinate
BindConstraint.set_coordinate
BindConstraint.get_offset
BindConstraint.set_offset

# Stock C symbol in header-overrides/clutter-main.h — Clutter.override.vala.
get_default_text_direction

# Header-sized GTypes in c-clutter-effect-abi.c + gsr-clutter-effect-abi.vapi
# (Vala priv* makes OffscreenEffect 48B; stock/libshell expect 24B).
ActorMeta
Effect
OffscreenEffect
ActorMetaPrivate

# Opaque GIR privates — C name clashes with Vala GObject instance private
# (e.g. ClutterActorPrivate) when the class has fields like rpc_lid.
ActorPrivate
PaintNodePrivate
ActorAccessiblePrivate

# GString return — generator maps poorly (GLib.String).
FrameClock.get_max_render_time_debug_info

# Replace with parameterless override so ColorNode/TextureNode can Object().
PipelineNode.new

# GLib.Closure is not a memcpy blob.
BindingPool.install_closure
BindingPool.override_closure

# Handed in overrides-clutter/Clutter.override.vala (needs get_slot).
EventSequence

# Live callback (IdleMonitor-style); GSourceFunc is not DBus-marshallable.
threads_add_repaint_func

# Nested <function>s on the Event union; ns already emits event_{add,remove}_filter / event_get
# with the same clutter_event_* cnames — skip class duplicates.
Event.add_filter
Event.get
Event.remove_filter

# Opaque paint records emitted as GObject — skip boxed ref/unref (clash with GObject).
PaintContext.ref
PaintContext.unref
PickContext.ref
PickContext.unref

# float[] / Point3D[] not mapped unless noop; St only needs the C symbols.
PaintNode.add_rectangles noop
PaintNode.add_texture_rectangles noop
ActorBox.from_vertices noop
Actor.get_abs_allocation_vertices noop

# Client-local content store — Actor.override.vala (Content not on wire).
Actor.get_content
Actor.set_content

# GJS construct literal on St.Widget — Actor.override.vala (clashes with get_constraints).
Actor.get_constraints

# Signal/method clash: generator prefers GIR signal; RPC body under destroy_rpc
# (Actor.override — [CCode cname = clutter_actor_destroy]).
Actor.destroy

# Vala auto-emits free/dup when struct has methods — skip GIR copies.
ActorBox.free
ActorBox.copy

# Bodies in overrides-clutter/ActorIter.override.vala (child walk via Actor RPC).
ActorIter.destroy
ActorIter.init
ActorIter.is_valid
ActorIter.next
ActorIter.prev
ActorIter.remove
