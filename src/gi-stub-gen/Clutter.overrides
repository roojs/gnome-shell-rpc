# gi-stub-gen overrides for Clutter-16 (Type[.method] key=value).
# Type-level keys drive emit policy; method keys tweak wire (see Meta.overrides).

# Phase C: GIR class/iface struct → Vala virtual/abstract slots (ABI vs headers).
Namespace emit_class_slots=1
Namespace emit_iface_slots=1
# Slot/signal clash → keep GIR signal (rename slot *_vfunc). Exact names.
Namespace signal_prefer=event
Namespace signal_prefer=button_press_event
Namespace signal_prefer=button_release_event
Namespace signal_prefer=scroll_event
Namespace signal_prefer=key_press_event
Namespace signal_prefer=key_release_event
Namespace signal_prefer=motion_event
Namespace signal_prefer=enter_event
Namespace signal_prefer=leave_event
Namespace signal_prefer=captured_event
Namespace signal_prefer=touch_event
Namespace signal_prefer=clicked
Namespace signal_prefer=long_press
Namespace signal_prefer=key_focus_in
Namespace signal_prefer=key_focus_out

# GIR union → GObject class + instance methods (Vala null, Meta key handlers).
Event emit=union-as-class
Event wire_as=gobject

# Opaque boxed records (size 0) → class + methods for St C ABI.
PaintContext emit=opaque-as-class
PaintVolume emit=opaque-as-class
PickContext emit=opaque-as-class

# Sized records: fields + GIR methods/ctors when present (Generator).
# Ctors are malloc0-only stubs — see missing.md "Struct ctor alloc stubs (audit)".
ActorBox emit=struct-methods
ActorIter emit=struct-methods
