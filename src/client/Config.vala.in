namespace Gsr.Client
{
	/** Optional disk JS directory (meson). Empty: client runs the compiled gresource. Overridden by {@code GNOME_SHELL_JS_DIR} env. */
	public const string GNOME_SHELL_JS_DIR = "@GNOME_SHELL_JS_DIR@";

	/** {@link GLib.Application} id for this executable (meson). */
	public const string APPLICATION_ID = "@APPLICATION_ID@";
}
