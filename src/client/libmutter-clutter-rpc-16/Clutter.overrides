# gi-stub-gen overrides for Clutter-16 (Type[.method] key=value).
# Type-level keys drive emit policy; method keys tweak wire (see Meta.overrides).

# Phase C: GIR class/iface struct → Vala virtual/abstract slots (ABI vs headers).
# Signal class closures are signal_* virtual signals (this class's GIR signal).
Namespace emit_class_slots=1
Namespace emit_iface_slots=1

# Typelibs included when this emit writes boxed types. Name-version is
# the typelib's own.
Namespace boxed=Cogl-16,Graphene-1.0,Mtk-16,Meta-16

# Event (sole Clutter GIR union) — denied; Compact in Event.vala.
# Frame (opaque boxed) — denied; Compact in Clutter.override.vala.

# Opaque boxed records (size 0) → class + methods for St C ABI.
PaintContext emit=opaque-as-class
PaintVolume emit=opaque-as-class
PickContext emit=opaque-as-class

# Sized records: fields + GIR methods/ctors when present (Generator).
# Ctors are malloc0-only stubs — see missing.md "Struct ctor alloc stubs (audit)".
ActorBox emit=struct-methods
ActorIter emit=struct-methods

# Stock implements Clutter.Content (same namespace, bare name).
# Without it, decoding a painted TextureContent into a Content GValue
# fails g_value_set_object and every overview stand-in reads null.
TextureContent implements=Content

# Denied layout slots → *_vfunc at stock Class offset; fallthrough body in
# Actor.override.vala (*_vfunc_fallback). Skip empty generator stub.
Actor.allocate vfunc_fallback=hand
Actor.get_preferred_width vfunc_fallback=hand
Actor.get_preferred_height vfunc_fallback=hand
Actor.show vfunc_fallback=hand
Actor.hide vfunc_fallback=hand

# Live.Hook registration — generator emits bind_vfunc calls; override defines relay_*.
# helper=1: emit Helper ID statics + register_vfunc_ids() into --helper-out.
Actor helper=1
Actor.get_preferred_width  relay=1
Actor.get_preferred_height relay=1
Actor.allocate             relay=1
Actor.event                relay=1
Actor.captured_event       relay=1
LayoutManager helper=1
LayoutManager.get_preferred_width  relay=1
LayoutManager.get_preferred_height relay=1
LayoutManager.allocate             relay=1

# Pango boxed types are not memcpy ay; GJS still needs the GObject names.
Text.attributes local=1
Text.font_description local=1