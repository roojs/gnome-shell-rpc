<snippet xmlns="http://www.gtk.org/introspection/core/1.0"
         xmlns:c="http://www.gtk.org/introspection/c/1.0"
         xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
		<method name="get_app_info" c:identifier="shell_app_get_app_info" glib:get-property="app-info">
			<return-value transfer-ownership="none" nullable="1">
				<type name="Gio.DesktopAppInfo" c:type="GDesktopAppInfo*"/>
			</return-value>
			<parameters>
				<instance-parameter name="self" transfer-ownership="none">
					<type name="Shell.App" c:type="ShellApp*"/>
				</instance-parameter>
			</parameters>
		</method>
		<property name="app-info" writable="1" construct-only="1" getter="get_app_info">
			<type name="Gio.DesktopAppInfo" c:type="GDesktopAppInfo*"/>
		</property>
</snippet>
