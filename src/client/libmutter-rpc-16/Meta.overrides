# gi-stub-gen overrides for Meta-16 (Type.method key=value).
# Mirrors vapi/Meta-16.metadata fixes the generator cannot infer from GIR.

# GIR returns GList<Clutter.Actor>; runtime elements are Meta.WindowActor.
Compositor.get_window_actors list_elem=WindowActor

# Opaque MetaSettings record — GObject class + Settings.override.vala (0.7.1).
Settings emit=opaque-as-class

# Stock implements Clutter.Content. emit_implements is off for the namespace.
BackgroundContent implements=Clutter.Content

# Not a stock Meta type. Meta.register() inlines Bin.register.
RpcSubprocess register=hand
