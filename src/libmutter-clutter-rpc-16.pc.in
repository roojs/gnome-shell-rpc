prefix=@prefix@
libdir=@libdir@
includedir=@includedir@
typelibdir=@typelibdir@
girdir=@girdir@

Name: mutter-clutter-rpc
Description: Mutter-shaped RPC Clutter client (Vala stubs)
Version: @version@
Requires: gio-2.0, gobject-2.0, atk, pango, mutter-cogl-@MUTTER_API_VERSION@, mutter-mtk-@MUTTER_API_VERSION@
Libs: -L${libdir} -lmutter-clutter-rpc-@MUTTER_API_VERSION@
Cflags: -I${includedir} @dep_cflags@
