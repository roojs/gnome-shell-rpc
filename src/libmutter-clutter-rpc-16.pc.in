prefix=@prefix@
libdir=@libdir@
includedir=@includedir@
typelibdir=@typelibdir@
girdir=@girdir@

Name: mutter-clutter-rpc
Description: Mutter-shaped RPC Clutter client (Vala stubs)
Version: @version@
Requires: gio-2.0, gobject-2.0, atk, pango, mutter-cogl-16, mutter-mtk-16
Libs: -L${libdir} -lmutter-clutter-rpc-16
Cflags: -I${includedir} @dep_cflags@
